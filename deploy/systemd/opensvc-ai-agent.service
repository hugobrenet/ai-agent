[Unit]
Description=OpenSVC AI agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opensvc-ai
Group=opensvc-ai
Environment=OPENSVC_AI_LISTEN_ADDR=127.0.0.1:8090
Environment=OPENSVC_AI_TLS_CERT_FILE=/etc/opensvc-ai/agent.crt
Environment=OPENSVC_AI_TLS_KEY_FILE=/etc/opensvc-ai/agent.key
Environment=OPENSVC_AI_JWT_VERIFY_KEY_FILE=/etc/opensvc-ai/cluster-ca.pem
Environment=OPENSVC_AI_CONVERSATION_DB_PATH=/var/lib/opensvc-ai-agent/conversations.db
# Configure OPENSVC_AI_MCP_URL and, for a private TLS CA, OPENSVC_AI_MCP_CA_FILE.
# This environment file also supplies the generic LLM configuration.
EnvironmentFile=/etc/opensvc-ai/agent-llm.env
ExecStart=/usr/local/libexec/opensvc-ai-agentd
Restart=on-failure
RestartSec=5s
TimeoutStopSec=35s
StateDirectory=opensvc-ai-agent
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
